# Opcional: Docker Compose usa valores por defecto si no existe .env.
# npm run docker:up copia este archivo a .env la primera vez.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=emitesis_db

DATABASE_URL=postgresql://postgres:password@db:5432/emitesis_db?schema=public
DIRECT_URL=postgresql://postgres:password@db:5432/emitesis_db?schema=public

DOMAIN=localhost

API_PORT=5000
API_PUBLISH_PORT=5000
JWT_SECRET=EmitesisSecretKey2026!
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
PUBLIC_APP_URL=http://localhost:3005
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3005

WEB_PORT=3005
WEB_PUBLISH_PORT=3005
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# true = no ejecutar seed al arrancar la API (por defecto vacío = sí seed).
SKIP_PRISMA_SEED=

MAIL_USER=
MAIL_PASS=

# Backend specific keys
RECAPTCHA_SECRET_KEY=
OPENAI_API_KEY=