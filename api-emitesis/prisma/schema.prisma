generator client {
  provider      = "prisma-client-js"
  // Docker Alpine (node:20-alpine) usa OpenSSL 3; sin esto el seed y la API fallan en el contenedor.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  password             String
  fullName             String
  role                 Role
  isActive             Boolean      @default(true)
  failedAttempts       Int          @default(0)
  lockoutUntil         DateTime?
  createdAt            DateTime     @default(now())
  companyId            String?
  resetToken           String?      @unique
  resetTokenExpires    DateTime?
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean      @default(false)
  webauthnChallenge    String?
  company              Company?     @relation(fields: [companyId], references: [id])
  assignmentsAsStudent Internship[] @relation("StudentInternship")
  assignmentsAsTutor   Internship[] @relation("TutorInternship")
  credential           UserCredential?
}

model Company {
  id             String       @id @default(uuid())
  ruc            String       @unique
  name           String
  address        String
  representative String
  email          String
  users          User[]
  agreements     Agreement[]
  internships    Internship[]
}

model Agreement {
  id        String   @id @default(uuid())
  companyId String
  startDate DateTime
  filePath  String
  status    String   @default("Activo")
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
}

model Internship {
  id          String       @id @default(uuid())
  studentId   String
  tutorId     String
  companyId   String
  startDate   DateTime
  endDate     DateTime?
  totalHours  Int
  location    String
  businessTutorName  String?
  businessTutorEmail String?
  lat         Float?
  lng         Float?
  testEnabled Boolean      @default(false)
  status      String       @default("En Proceso")
  createdAt   DateTime     @default(now())
  attendances Attendance[]
  documents   Document[]
  evaluation  Evaluation?
  company     Company      @relation(fields: [companyId], references: [id])
  student     User         @relation("StudentInternship", fields: [studentId], references: [id])
  tutor       User         @relation("TutorInternship", fields: [tutorId], references: [id])
}

model Evaluation {
  id              String     @id @default(uuid())
  internshipId    String     @unique
  punctuality     Int        @default(0)
  teamwork        Int        @default(0)
  technicalSkills Int        @default(0)
  proactivity     Int        @default(0)
  attitude        Int        @default(0)
  observations    String?
  status          String     @default("PENDIENTE") // PENDIENTE, COMPLETADO
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  internship      Internship @relation(fields: [internshipId], references: [id])
}

model Document {
  id           String         @id @default(uuid())
  internshipId String
  name         String
  filePath     String?
  status       DocumentStatus @default(PENDIENTE)
  observations String?
  startDate    DateTime?      // Fecha de apertura (RF-DOC-001)
  dueDate      DateTime?      // Fecha límite (RF-DOC-001)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  internship   Internship     @relation(fields: [internshipId], references: [id])
}

model Attendance {
  id             String          @id @default(uuid())
  internshipId   String
  checkIn        DateTime
  checkOut       DateTime?
  lat            Float
  lng            Float
  distanceKm     Float?
  checkInPhoto   String?         // RF-15: foto de entrada
  checkOutPhoto  String?         // RF-15: foto de salida
  activityPhotos ActivityPhoto[] // RF-17: fotos de actividades
  internship     Internship      @relation(fields: [internshipId], references: [id])
}

// RF-17: Fotos de actividades diarias
model ActivityPhoto {
  id           String     @id @default(uuid())
  attendanceId String
  photoUrl     String
  caption      String?
  createdAt    DateTime   @default(now())
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
}

// RF-14: Credencial WebAuthn (huella dactilar)
model UserCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  status    String   // EXITO, FALLIDO
  error     String?
  sentAt    DateTime @default(now())
  metadata  Json?    // Para guardar IDs relacionados (empresaId, convenioId, etc)
}

enum Role {
  ADMIN
  COORDINADOR
  TUTOR
  ESTUDIANTE
  EMPRESA
}

enum DocumentStatus {
  PENDIENTE
  EN_REVISION_TUTOR
  APROBADO_TUTOR
  RECHAZADO_TUTOR
  APROBADO_DEFINITIVO
  RECHAZADO_COORDINADOR
  INCUMPLIDO
}
