generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  password             String
  fullName             String
  role                 Role
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  assignmentsAsStudent Internship[] @relation("StudentInternship")
  assignmentsAsTutor   Internship[] @relation("TutorInternship")
}

model Company {
  id             String       @id @default(uuid())
  ruc            String       @unique
  name           String
  address        String
  representative String
  email          String
  agreements     Agreement[]
  internships    Internship[]
}

model Agreement {
  id        String   @id @default(uuid())
  companyId String
  startDate DateTime
  filePath  String
  status    String   @default("Activo")
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
}

model Internship {
  id          String       @id @default(uuid())
  studentId   String
  tutorId     String
  companyId   String
  startDate   DateTime
  endDate     DateTime?
  totalHours  Int
  location    String
  lat         Float?
  lng         Float?
  status      String       @default("En Proceso")
  createdAt   DateTime     @default(now())
  attendances Attendance[]
  documents   Document[]
  company     Company      @relation(fields: [companyId], references: [id])
  student     User         @relation("StudentInternship", fields: [studentId], references: [id])
  tutor       User         @relation("TutorInternship", fields: [tutorId], references: [id])
}

model Document {
  id           String         @id @default(uuid())
  internshipId String
  name         String
  filePath     String?
  status       DocumentStatus @default(PENDIENTE)
  observations String?
  dueDate      DateTime?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  internship   Internship     @relation(fields: [internshipId], references: [id])
}

model Attendance {
  id           String     @id @default(uuid())
  internshipId String
  checkIn      DateTime
  checkOut     DateTime?
  lat          Float
  lng          Float
  distanceKm   Float?
  internship   Internship @relation(fields: [internshipId], references: [id])
}

enum Role {
  ADMIN
  COORDINADOR
  TUTOR
  ESTUDIANTE
  EMPRESA
}

enum DocumentStatus {
  PENDIENTE
  EN_REVISION_TUTOR
  APROBADO_TUTOR
  RECHAZADO_TUTOR
  APROBADO_DEFINITIVO
  RECHAZADO_COORDINADOR
}
