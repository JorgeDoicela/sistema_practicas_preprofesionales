generator client {
  provider      = "prisma-client-js"
  // Docker Alpine (node:20-alpine) usa OpenSSL 3; sin esto el seed y la API fallan en el contenedor.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  password             String
  fullName             String
  role                 Role
  isActive             Boolean      @default(true)
  failedAttempts       Int          @default(0)
  lockoutUntil         DateTime?
  createdAt            DateTime     @default(now())
  companyId            String?
  careerId             String?
  resetToken           String?      @unique
  resetTokenExpires    DateTime?
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean      @default(false)
  webauthnChallenge    String?
  // Datos personales/contacto
  cedula               String?      @unique  // Cédula de identidad (obligatoria en documentos Ecuador)
  phone                String?               // Teléfono de contacto
  ciclo                String?               // Ciclo/nivel académico (ej: "5to Ciclo") — para estudiantes
  // RF-LOPDP: Cumplimiento Ley de Protección de Datos Ecuador
  lopdpAccepted       Boolean      @default(false)
  lopdpAcceptedAt     DateTime?
  lopdpVersion        String?      @default("1.0")
  company              Company?     @relation(fields: [companyId], references: [id])
  career               Career?      @relation(fields: [careerId], references: [id])
  assignmentsAsStudent Internship[] @relation("StudentInternship")
  assignmentsAsTutor   Internship[] @relation("TutorInternship")
  credential           UserCredential?
  systemLogs           SystemLog[]
  dataRequests         DataRequest[]
  notifications        InAppNotification[]
  statusChanges        InternshipStatusHistory[]
  documentComments     DocumentComment[]
  chatRoomMembers      ChatRoomMember[]
  sentMessages         ChatMessage[]
}

/// Registro de actividad del sistema (peticiones HTTP, eventos relevantes, etc.)
model SystemLog {
  id          String   @id @default(uuid())
  createdAt DateTime @default(now())
  level       String   // INFO, WARN, ERROR
  category    String   // HTTP, AUTH, SYSTEM
  message     String
  method      String?
  path        String?
  statusCode  Int?
  userId      String?
  actorEmail  String?
  ip          String?
  durationMs  Int?
  metadata    Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([category])
}

model Company {
  id             String       @id @default(uuid())
  ruc            String       @unique
  name           String
  address        String
  representative String
  email          String
  phone          String?               // Teléfono principal de contacto
  city           String?               // Ciudad / cantón
  sector         String?               // Sector económico / actividad principal
  users          User[]
  agreements     Agreement[]
  internships    Internship[]
}

model Agreement {
  id         String    @id @default(uuid())
  companyId  String
  startDate  DateTime
  endDate    DateTime?           // Fecha de vencimiento del convenio (renovación requerida)
  type       String    @default("GENERAL")  // GENERAL, ESPECIFICO, MARCO
  maxInterns Int?      @default(1)          // Cupos máximos de pasantes simultáneos
  filePath   String
  status     String    @default("Activo")
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Internship {
  id          String       @id @default(uuid())
  studentId   String
  tutorId     String
  companyId   String
  careerId    String?
  startDate   DateTime
  endDate     DateTime?
  totalHours  Int
  /// Modalidad de ejecución de la práctica (puede diferir de la modalidad de la carrera)
  modalidad         Modalidad    @default(PRESENCIAL)
  /// Descripción libre del lugar físico o virtual de la práctica
  location          String?
  businessTutorName     String?
  businessTutorEmail    String?
  businessTutorPhone    String?  // Teléfono del tutor/supervisor empresarial
  businessTutorPosition String?  // Cargo del tutor empresarial (ej: Jefe de RRHH)
  activityDescription   String?  // Descripción general de las actividades a realizar
  lat               Float?
  lng               Float?
  /// RF-ATT-LOC: Array JSON de ubicaciones permitidas [{label,lat,lng,radiusM?}]
  allowedLocations  Json?
  testEnabled       Boolean      @default(false)
  status      String       @default("En Proceso")
  createdAt   DateTime     @default(now())
  attendances Attendance[]
  documents   Document[]
  evaluations  Evaluation[]
  monitoringVisits MonitoringVisit[]
  statusHistory    InternshipStatusHistory[]
  company     Company      @relation(fields: [companyId], references: [id])
  career      Career?      @relation(fields: [careerId], references: [id])
  student     User         @relation("StudentInternship", fields: [studentId], references: [id])
  tutor       User         @relation("TutorInternship", fields: [tutorId], references: [id])
}

model Career {
  id          String       @id @default(uuid())
  name        String       @unique
  faculty     String?
  /// Modalidad oficial de la carrera según el programa académico del ISTPET
  modalidad   Modalidad    @default(PRESENCIAL)
  users       User[]
  internships Internship[]
  documentTemplates DocumentTemplate[]
  createdAt   DateTime     @default(now())
  /// RF-CAREER-001: Configuración dinámica (horas requeridas, docs obligatorios, etc.)
  config      Json?        @default("{\"requiredHours\": 160}")
}

model InternshipStatusHistory {
  id           String     @id @default(uuid())
  internshipId String
  oldStatus    String?
  newStatus    String
  changedById  String?
  reason       String?
  createdAt    DateTime   @default(now())
  
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  changedBy    User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([internshipId])
  @@index([createdAt])
}

/// Catálogo institucional: qué documentos se crean por cada práctica (obligatorios/opcionales, orden, certificado).
model DocumentTemplate {
  id                  String   @id @default(uuid())
  name                String
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  isRequired          Boolean  @default(true)
  isCertificateSlot   Boolean  @default(false)
  blankFileKey        String?
  careerId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  career              Career?  @relation(fields: [careerId], references: [id], onDelete: SetNull)
  documents           Document[]

  @@index([isActive, sortOrder])
  @@index([careerId])
}

model Evaluation {
  id              String         @id @default(uuid())
  internshipId    String
  type            EvaluationType @default(EMPRESARIAL)
  evaluatorId     String?
  punctuality     Int            @default(0)
  teamwork        Int            @default(0)
  technicalSkills Int            @default(0)
  proactivity     Int            @default(0)
  attitude        Int            @default(0)
  observations    String?
  status          String         @default("PENDIENTE") // PENDIENTE, COMPLETADO
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  internship      Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([internshipId, type])
  @@index([internshipId])
}

model MonitoringVisit {
  id              String     @id @default(uuid())
  internshipId    String
  date            DateTime
  type            String     @default("PRESENCIAL") // PRESENCIAL, VIRTUAL
  location        String?
  observations    String
  recommendations String?
  evidenceUrl     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  internship      Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

enum EvaluationType {
  EMPRESARIAL
  ACADEMICA
}

/// Modalidad de cursado/ejecución — aplica a Carrera y a Práctica
enum Modalidad {
  PRESENCIAL
  SEMIPRESENCIAL
  EN_LINEA
  HIBRIDA
}

model Document {
  id                String            @id @default(uuid())
  internshipId      String
  name              String
  filePath          String?
  status            DocumentStatus    @default(PENDIENTE)
  observations      String?
  startDate         DateTime? // Fecha de apertura (RF-DOC-001)
  dueDate           DateTime? // Fecha límite (RF-DOC-001)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  templateId        String?
  isRequired        Boolean           @default(true)
  isCertificateSlot Boolean           @default(false)
  blankFileKey      String?
  sortOrder         Int               @default(0)
  /// Anotaciones de revisión (resaltados, tachados, comentarios por fragmento) en JSON
  reviewAnnotations Json?
  
  /// RF-SIG-001: Firma Electrónica (Token/Certificado)
  isDigitallySigned Boolean   @default(false)
  signatureDate     DateTime?
  signatureKey      String?   // Hash del certificado o referencia al sello

  versions          DocumentVersion[]
  comments          DocumentComment[]

  internship        Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  template          DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([internshipId, sortOrder])
  @@index([templateId])
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  filePath     String
  observations String?
  createdAt    DateTime @default(now())
  
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([createdAt])
}

model Attendance {
  id                  String          @id @default(uuid())
  internshipId        String
  checkIn             DateTime
  checkOut            DateTime?
  lat                 Float
  lng                 Float
  distanceKm          Float?
  checkInPhoto        String?         // RF-15: foto de entrada
  checkOutPhoto       String?         // RF-15: foto de salida
  activityDescription String?         // Descripción de actividades realizadas en el día (diario de prácticas)
  activityPhotos      ActivityPhoto[] // RF-17: fotos de actividades
  internship          Internship      @relation(fields: [internshipId], references: [id], onDelete: Cascade)
}

// RF-17: Fotos de actividades diarias
model ActivityPhoto {
  id           String     @id @default(uuid())
  attendanceId String
  photoUrl     String
  caption      String?
  createdAt    DateTime   @default(now())
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
}

/// RF-LOPDP: Solicitudes de derechos ARCO (Acceso, Rectificación, Cancelación, Oposición)
model DataRequest {
  id          String   @id @default(uuid())
  userId      String
  type        String   // ACCESO, RECTIFICACION, CANCELACION, OPOSICION
  details     String?
  status      String   @default("PENDIENTE") // PENDIENTE, EN_REVISION, COMPLETADA, RECHAZADA
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

// RF-14: Credencial WebAuthn (huella dactilar)
model UserCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  status    String   // EXITO, FALLIDO
  error     String?
  sentAt    DateTime @default(now())
  metadata  Json?    // Para guardar IDs relacionados (empresaId, convenioId, etc)
}

enum Role {
  ADMIN
  COORDINADOR
  TUTOR
  TUTOR_EMPRESARIAL
  ESTUDIANTE
  EMPRESA
}

/// Chat: controla qué pares de roles pueden intercambiar mensajes.
model ChatPermission {
  id        String   @id @default(uuid())
  fromRole  Role
  toRole    Role
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromRole, toRole])
}

/// Chat: sala de conversación (1:1 o grupal).
model ChatRoom {
  id        String           @id @default(uuid())
  name      String?
  isGroup   Boolean          @default(false)
  createdAt DateTime         @default(now())
  members   ChatRoomMember[]
  messages  ChatMessage[]
}

/// Chat: miembros de una sala.
model ChatRoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

/// Chat: mensajes individuales.
model ChatMessage {
  id           String    @id @default(uuid())
  roomId       String
  senderId     String
  content      String
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  /// RF-LOPDP: eliminación por el remitente (dentro de la ventana permitida)
  deletedAt    DateTime?
  /// RF-LOPDP: anonimización por solicitud ARCO-Cancelación
  isAnonymized Boolean   @default(false)
  room         ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId, isAnonymized])
}

enum DocumentStatus {
  PENDIENTE
  EN_REVISION_TUTOR
  APROBADO_TUTOR
  RECHAZADO_TUTOR
  APROBADO_DEFINITIVO
  RECHAZADO_COORDINADOR
  INCUMPLIDO
}

/// Configuraciones globales del sistema (Radio GPS, SMTP, etc.)
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("GENERAL") // GENERAL, GPS, EMAIL, AUTH
  updatedAt   DateTime @updatedAt
}

/// Anuncios globales visibles para todos los usuarios
model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, DANGER
  isActive  Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime?
  userId    String?  // Quién creó el anuncio
  createdAt DateTime @default(now())
}
/// Notificaciones internas en tiempo real (In-App)
model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  isRead    Boolean  @default(false)
  link      String?  // Ruta interna para redirigir al hacer clic
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// RF-COM-001: Hilos de conversación por documento (Feedback Académico)
model DocumentComment {
  id          String   @id @default(uuid())
  documentId  String
  userId      String
  content     String
  createdAt   DateTime @default(now())
  
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([createdAt])
}
