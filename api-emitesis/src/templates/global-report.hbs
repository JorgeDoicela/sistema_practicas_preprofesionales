<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Reporte Global de Prácticas</title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #334155; line-height: 1.5; margin: 0; padding: 40px; }
        .header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #003366; padding-bottom: 20px; }
        .header h1 { color: #003366; margin: 0; font-size: 24px; text-transform: uppercase; }
        .header p { color: #64748b; margin: 5px 0 0; font-size: 12px; font-weight: bold; }
        
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px; }
        .stat-card { background: #f8fafc; border: 1px solid #e2e8f0; padding: 15px; border-radius: 8px; text-align: center; }
        .stat-card .label { font-size: 10px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 5px; }
        .stat-card .value { font-size: 20px; color: #003366; font-weight: 800; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 11px; }
        th { background: #003366; color: white; text-align: left; padding: 10px; text-transform: uppercase; }
        td { border-bottom: 1px solid #e2e8f0; padding: 10px; }
        tr:nth-child(even) { background: #f8fafc; }
        
        .status-badge { padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 9px; }
        .status-proceso { background: #dcfce7; color: #166534; }
        .status-completado { background: #dbeafe; color: #1e40af; }
        
        .footer { margin-top: 40px; text-align: center; font-size: 10px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 20px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Reporte Global de Prácticas Preprofesionales</h1>
        <p>Generado el {{date}} | ISTPET Sistema de Gestión</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="label">Asignaciones Activas</div>
            <div class="value">{{stats.assignmentsCount}}</div>
        </div>
        <div class="stat-card">
            <div class="label">Docs. Pendientes</div>
            <div class="value">{{stats.pendingDocs}}</div>
        </div>
        <div class="stat-card">
            <div class="label">Horas Cumplidas</div>
            <div class="value">{{stats.totalCompletedHours}} h</div>
        </div>
        <div class="stat-card">
            <div class="label">Progreso Global</div>
            <div class="value">{{stats.progressPercentage}}%</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Estudiante</th>
                <th>Empresa</th>
                <th>Estado</th>
                <th>Hrs. Plan</th>
                <th>Hrs. Cumpl</th>
                <th>Progreso</th>
            </tr>
        </thead>
        <tbody>
            {{#each internships}}
            <tr>
                <td><strong>{{student}}</strong></td>
                <td>{{company}}</td>
                <td>{{status}}</td>
                <td>{{planned}} h</td>
                <td>{{completed}} h</td>
                <td>{{progress}}%</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="footer">
        Este documento es un reporte informativo generado automáticamente por el Sistema de Prácticas ISTPET.
    </div>
</body>
</html>
