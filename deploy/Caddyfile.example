# Ejemplo para Caddy en el VPS (instalación nativa), con contenedores publicados en 127.0.0.1:3005 y :5000.
# 1) Sustituye tu-dominio.edu.ec por tu dominio.
# 2) Ajusta NEXT_PUBLIC_API_URL y PUBLIC_APP_URL en el .env de Docker a https://tu-dominio.edu.ec/api y https://tu-dominio.edu.ec
# 3) Reconstruye el front: docker compose build web && docker compose up -d

tu-dominio.edu.ec {
	encode gzip zstd
	reverse_proxy /api* 127.0.0.1:5000
	reverse_proxy 127.0.0.1:3005
}
